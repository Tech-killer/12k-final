# Server Configuration
PORT=8000
NODE_ENV=development

# MongoDB Atlas Cloud Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/12k?retryWrites=true&w=majority
MONGODB_DB_NAME=12k

# SMTP Email Configuration (Optional)
HOSTINGER_SMTP_HOST=smtp.hostinger.com
HOSTINGER_SMTP_PORT=465
HOSTINGER_SMTP_SECURE=true
HOSTINGER_SMTP_USER=noreply@example.com
HOSTINGER_SMTP_PASS=your_smtp_password_here

# Mail Dispatcher Webhooks
HOSTINGER_MAIL_URL=https://example.com/send_otp_mail.php
HOSTINGER_ASSET_MAIL_URL=https://example.com/send_asset_mail.php
HOSTINGER_MAIL_SECRET=your_mail_secret_here
